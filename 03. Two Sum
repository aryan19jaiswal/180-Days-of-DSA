class Solution {
    public int[] twoSum(int[] nums, int target) {
        Map<Integer, Integer> map = new HashMap<>();
        map.put(nums[0], 0);

        int[] ans = {-1, -1};

        for(int i=1; i<nums.length; i++){
            int req = target - nums[i];

            if(map.containsKey(req)){
                ans[0] = map.get(req);
                ans[1] = i;
                return ans;
            }
            else{
                map.put(nums[i], i);
            }
        }

        return ans;
    }
}
