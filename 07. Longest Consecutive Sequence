class Solution {
    public int longestConsecutive(int[] nums) {
        int ans = 0;

        HashSet<Integer> set = new HashSet<>();

        for(int num: nums){
            set.add(num);
        }

        for(int num: set){
            int count = 1;
            if(!set.contains(num-1)){
                while(set.contains(num+1)){
                    count++;
                    num++;
                }
            }
            ans = Math.max(count, ans);
        }

        return ans;
    }
}
