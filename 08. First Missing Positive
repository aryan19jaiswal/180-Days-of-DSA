class Solution {
    public int firstMissingPositive(int[] nums) {
        int n = nums.length;

        // Part 1: Place each positive number x at index x - 1
        for (int i = 0; i < n; i++) {
            while (nums[i] > 0 && nums[i] <= n
                    && nums[i] != nums[nums[i] - 1]) {

                int x = nums[i];
                int y = nums[x - 1];

                nums[x - 1] = x;
                nums[i] = y;
            }
        }

        // Part 2: Find the first missing positive
        for (int i = 0; i < n; i++) {
            if (nums[i] != i + 1) {
                return i + 1;
            }
        }

        // All numbers from 1 to n are present
        return n + 1;
    }
}
