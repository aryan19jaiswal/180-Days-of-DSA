class Solution {
    public boolean isPalindrome(String s) {
        int beg = 0;
        int end = s.length() - 1;

        while (beg < end) {

            // Skip non-alphanumeric characters from the beginning
            while (beg < end && !Character.isLetterOrDigit(s.charAt(beg))) {
                beg++;
            }

            // Skip non-alphanumeric characters from the end
            while (beg < end && !Character.isLetterOrDigit(s.charAt(end))) {
                end--;
            }

            // Compare characters without considering case
            if (Character.toLowerCase(s.charAt(beg)) !=
                Character.toLowerCase(s.charAt(end))) {
                return false;
            }

            beg++;
            end--;
        }

        return true;
    }
}
